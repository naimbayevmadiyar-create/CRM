# ── Supabase ─────────────────────────────────────────────────────────────────
# Настройки проекта → Data API. Сервисный ключ секретный: он обходит RLS
# и в браузер попадать не должен никогда.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Подпись сессии ───────────────────────────────────────────────────────────
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── Пароли ───────────────────────────────────────────────────────────────────
# Сгенерировать: npm run hash -- <пароль>
# Класть сюда нужно строку вида scrypt$<соль>$<хеш>, а не сам пароль.
ADMIN_PASSWORD_HASH=
MASTER_PASSWORD_HASH=

# ── Прочее ───────────────────────────────────────────────────────────────────
# Соль для хеша IP. IP в базе не хранится, только хеш — для защиты от накрутки.
# Сгенерировать так же, как SESSION_SECRET.
IP_HASH_SALT=

# Домен сайта, с которого принимаем обращения. Без слэша на конце.
TRACK_ALLOWED_ORIGIN=https://chestny-service.kz

# Уведомления о новых обращениях. Необязательно: без них CRM работает,
# просто не пишет в Telegram.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
